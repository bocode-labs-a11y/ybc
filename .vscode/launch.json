{
    // 本地 MinGW 调试配置（gcc/gdb 位于 D:\c\bin，32 位）
    // 按 F5 会先执行 tasks.json 里的 “C/C++: gcc.exe 生成活动文件” 编译当前 .c 文件
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) 启动 - 当前文件",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:\\c\\bin\\gdb.exe",
            "preLaunchTask": "C/C++: gcc.exe 生成活动文件",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) 附加到进程",
            "type": "cppdbg",
            "request": "attach",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "D:\\c\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
